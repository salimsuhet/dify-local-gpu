# ============================================================================
# Assistente de Código Local (Dify + Ollama, 2 GPUs) — Configuração
# ============================================================================
# Copie este arquivo para `.env` e ajuste os valores conforme sua máquina.
#   cp .env.example .env            (Linux/WSL2)
#   Copy-Item .env.example .env     (Windows PowerShell)
#
# Premissas do projeto: tudo roda localmente e todos os componentes usam
# licenças abertas (veja docs/licencas.md antes de trocar algum modelo).
# ============================================================================

# ----------------------------------------------------------------------------
# Sistema operacional do host — define o overlay de GPU usado
# ----------------------------------------------------------------------------
#   linux   -> compose/gpu.linux.yml   (device_ids; inclui Docker nativo no WSL2)
#   windows -> compose/gpu.windows.yml (Docker Desktop; CUDA_VISIBLE_DEVICES)
HOST_OS=linux

# ----------------------------------------------------------------------------
# GPUs físicas — índices conforme `nvidia-smi -L`
# ----------------------------------------------------------------------------
GPU0_DEVICE_INDEX=0
GPU1_DEVICE_INDEX=1

# ----------------------------------------------------------------------------
# GPU 0 — modelo de CÓDIGO (o assistente principal)
# ----------------------------------------------------------------------------
# Fica sozinho na GPU para ter a maior janela de contexto possível.
# Opções para 6GB de VRAM (ver docs/model-reference.md):
#   qwen2.5-coder:7b-instruct-q4_K_M   (recomendado, Apache 2.0)
#   qwen2.5-coder:1.5b-instruct-q4_K_M (bem mais leve/rápido, Apache 2.0)
#   (o 3B da mesma família NÃO é Apache 2.0 — veja docs/licencas.md)
GPU0_CODE_MODEL=qwen2.5-coder:7b-instruct-q4_K_M

OLLAMA_GPU0_PORT=11434
# Janela de contexto em tokens. Código precisa de contexto: 8192 cabe em 6GB
# com o modelo 7B. Reduza para 6144/4096 se aparecer offload para CPU.
OLLAMA_GPU0_NUM_CTX=8192
# 1 = uma requisição por vez (cada requisição paralela multiplica o KV cache)
OLLAMA_GPU0_NUM_PARALLEL=1
# Quantos modelos ficam carregados na VRAM ao mesmo tempo nesta GPU.
# 1 = só o modelo de código. Aumente se a placa tiver VRAM para mais modelos.
OLLAMA_GPU0_MAX_LOADED_MODELS=1

# ----------------------------------------------------------------------------
# GPU 1 — modelo de CONVERSA (apoio) + EMBEDDING (RAG sobre código/docs)
# ----------------------------------------------------------------------------
# Modelo generalista para conversar, interpretar pedidos e rotear no Chatflow.
# Deixe em branco (GPU1_CHAT_MODEL=) para usar só o modelo de código.
GPU1_CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M

# Embedding para as Bases de Conhecimento (vetores gravados no pgvector).
GPU1_EMBED_MODEL=nomic-embed-text

OLLAMA_GPU1_PORT=11435
OLLAMA_GPU1_NUM_CTX=4096
OLLAMA_GPU1_NUM_PARALLEL=1
# 2 = conversa + embedding carregados juntos. Se outro modelo for usado nesta
# GPU além desses, um deles é descarregado (alguns segundos de recarga).
OLLAMA_GPU1_MAX_LOADED_MODELS=2

# Tempo que um modelo fica na VRAM depois da última requisição
OLLAMA_KEEP_ALIVE=30m

# Margem de VRAM (MiB) que o Ollama deixa livre em cada GPU ao decidir quantas
# camadas cabem. O padrão do llama.cpp (1024) joga ~3 camadas de um 7B para a
# CPU numa placa de 6 GB; 256 coloca o modelo inteiro na GPU. Aumente (512)
# se aparecer erro de falta de memória da GPU.
OLLAMA_VRAM_MARGIN_MIB=256

# ----------------------------------------------------------------------------
# Dify
# ----------------------------------------------------------------------------
DIFY_HTTP_PORT=80
DIFY_HTTPS_PORT=443

# Onde o repositório oficial do Dify é clonado pelo bootstrap
DIFY_DIR=./dify

# Tag do Dify a clonar ("latest" = última release). Testado com 1.19.0.
DIFY_VERSION=latest

# ----------------------------------------------------------------------------
# Rede Docker compartilhada entre Dify e os containers Ollama
# ----------------------------------------------------------------------------
# O bootstrap conecta api/worker/plugin_daemon do Dify a esta rede, então no
# Dify a Base URL é sempre http://ollama-gpu0:11434 e http://ollama-gpu1:11434
# (em Linux e Windows).
SHARED_NETWORK_NAME=dify-local-gpu-net
