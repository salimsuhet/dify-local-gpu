# ============================================================================
# Dify + Ollama Local GPU Stack — Configuração
# ============================================================================
# Copie este arquivo para `.env` e ajuste os valores conforme sua máquina.
#   cp .env.example .env
#
# Tudo aqui roda em localhost. Nenhuma porta precisa ser exposta à rede
# externa para este stack funcionar.
# ============================================================================

# ----------------------------------------------------------------------------
# Sistema Operacional do host
# ----------------------------------------------------------------------------
# Define como o Docker resolve nomes/IPs e como o passthrough de GPU é feito.
# Valores aceitos: "linux" ou "windows"
#
#   linux   -> usa NVIDIA_VISIBLE_DEVICES por container (1 GPU por container,
#              isolamento real entre as duas instâncias Ollama)
#   windows -> Docker Desktop / WSL2. O passthrough de GPU ESPECÍFICA por
#              container (device_ids) NÃO é confiável no Docker Desktop hoje
#              (há relatos confirmados de apenas a primeira GPU ser
#              reconhecida, ou de device_ids ser ignorado). Por isso, no modo
#              "windows" os dois containers Ollama sobem com acesso a TODAS
#              as GPUs visíveis, e é o próprio Ollama (não o Docker) quem
#              decide onde carregar cada modelo. Veja docs/windows-gpu-notes.md.
HOST_OS=linux

# Nome do host usado pelo Dify para alcançar os containers Ollama/Qdrant.
#   Linux:   geralmente não precisa mudar — os scripts resolvem via rede Docker
#   Windows: Docker Desktop expõe host.docker.internal automaticamente
# Deixe em branco para detecção automática pelos scripts.
DOCKER_HOST_GATEWAY=

# ----------------------------------------------------------------------------
# GPUs físicas (relevante apenas quando HOST_OS=linux)
# ----------------------------------------------------------------------------
# Índice das GPUs conforme reportado por `nvidia-smi -L`.
# Na maioria das workstations com 2 GPUs idênticas, será 0 e 1.
GPU0_DEVICE_INDEX=0
GPU1_DEVICE_INDEX=1

# ----------------------------------------------------------------------------
# GPU 0 — reservada para o LLM de CHAT (modelo principal de geração)
# ----------------------------------------------------------------------------
# Modelos recomendados para 6GB de VRAM (ver docs/model-reference.md):
#   qwen2.5:7b-instruct-q4_K_M     (recomendado — bom custo/benefício em PT-BR)
#   llama3.1:8b-instruct-q4_K_M    (alternativa sólida, contexto 128k)
#   mistral:7b-instruct-q4_K_M     (mais leve, resposta rápida)
#   gemma2:9b-instruct-q4_K_M      (cabe justo, qualidade boa)
GPU0_CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M

# Porta exposta em localhost para esta instância Ollama
OLLAMA_GPU0_PORT=11434

# Janela de contexto (tokens). Reduza se houver OOM; aumente se tiver margem de VRAM.
OLLAMA_GPU0_NUM_CTX=4096

# Quantas requisições paralelas esta instância aceita (1 = sem fila de modelo duplicado em VRAM)
OLLAMA_GPU0_NUM_PARALLEL=1

# ----------------------------------------------------------------------------
# GPU 1 — reservada para EMBEDDING e RERANK (pipeline de RAG)
# ----------------------------------------------------------------------------
# Modelos de embedding são pequenos (cabem várias vezes em 6GB):
#   nomic-embed-text               (recomendado — 768 dim, até 8192 tokens)
#   bge-m3                         (multilíngue, bom para PT-BR)
#   mxbai-embed-large               (alta qualidade, um pouco mais pesado)
GPU1_EMBED_MODEL=nomic-embed-text

# Reranker é opcional, mas melhora muito a precisão do RAG.
# Deixe em branco (GPU1_RERANK_MODEL=) para não carregar nenhum reranker.
GPU1_RERANK_MODEL=bge-reranker-v2-m3

# Porta exposta em localhost para esta instância Ollama
OLLAMA_GPU1_PORT=11435

OLLAMA_GPU1_NUM_CTX=2048
OLLAMA_GPU1_NUM_PARALLEL=2

# ----------------------------------------------------------------------------
# Vector Store (RAG) — Qdrant
# ----------------------------------------------------------------------------
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# Chave de API interna do Qdrant (gere uma string aleatória própria)
QDRANT_API_KEY=changeme-qdrant-key

# ----------------------------------------------------------------------------
# Dify — porta web local
# ----------------------------------------------------------------------------
# Porta em que o Dify Web/Nginx fica acessível em localhost
DIFY_HTTP_PORT=80
DIFY_HTTPS_PORT=443

# Caminho onde o repositório oficial do Dify será clonado pelo bootstrap.sh
DIFY_DIR=./dify

# Tag/branch do Dify a clonar (deixe "main" para a última estável via release tag)
DIFY_VERSION=latest

# ----------------------------------------------------------------------------
# Rede Docker compartilhada entre Dify e os containers Ollama/Qdrant
# ----------------------------------------------------------------------------
SHARED_NETWORK_NAME=dify-local-gpu-net
